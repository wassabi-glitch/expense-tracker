# The base URL of the FastAPI backend.
# In local development, physical devices cannot connect to "localhost".
# Use your computer's actual Wi-Fi IP address here (e.g. 192.168.1.15).
# If you are strictly using the Android Emulator, you can use http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://<your-ip-address>:8000
